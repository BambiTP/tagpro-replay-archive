{
  "name": "tagpro-archive-tunnel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        // One object, named "v1", holding {url, updated} for the archive
        // host's quick-tunnel hostname. Rewritten by host/supervise.sh every
        // 60s. A DO rather than KV because KV's 60s read cache would let
        // /status and /go disagree for a minute after every rotation.
        "name": "REGISTRY",
        "class_name": "TunnelRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelRegistry"]
    }
  ]
}
